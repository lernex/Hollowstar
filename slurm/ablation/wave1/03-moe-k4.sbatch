#!/bin/bash
# MoRE ablation row 03: MoE k=4
# Isolates: sparse routing without recursion
# Generated by `python -m metis_ablation.campaign slurm`; edit the generator,
# not this file.
#SBATCH --job-name=more-moe-k4
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=4
#SBATCH --gpus-per-task=1
#SBATCH --cpus-per-task=6
#SBATCH --time=36:00:00
#SBATCH --output=${METIS_SCRATCH:?set METIS_SCRATCH}/more-ablations/moe-k4/slurm-%j.out
#SBATCH --error=${METIS_SCRATCH:?set METIS_SCRATCH}/more-ablations/moe-k4/slurm-%j.err

set -euo pipefail

# Every row consumes an identical global batch (1835008 tokens),
# so the rank count is part of the experiment. A mismatch is a hard error in
# the trainer rather than a silently different run.
export WORLD_SIZE=16
export MASTER_ADDR="$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n1)"
export MASTER_PORT=29503
export OMP_NUM_THREADS=6
export PYTHONPATH="${METIS_REPO:?set METIS_REPO}/src:${PYTHONPATH:-}"
# Deterministic RCCL ordering keeps the gradient all-reduce reproducible across
# restarts, which matters because rows are compared to each other, not to a
# tolerance.
export NCCL_ALGO=Ring
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1

mkdir -p "${METIS_SCRATCH:?set METIS_SCRATCH}/more-ablations/moe-k4"

srun --kill-on-bad-exit=1 python -m metis_ablation.train \
  --row moe-k4 \
  --output "${METIS_SCRATCH:?set METIS_SCRATCH}/more-ablations" \
  --release-root "${METIS_RELEASE_ROOT:?set METIS_RELEASE_ROOT}" \
  --budget-tokens 50000000000 \
  --seed 16062026 \
  --checkpoint-every 5000 \
  --analysis-every 1000 \
  --telemetry-every 10
