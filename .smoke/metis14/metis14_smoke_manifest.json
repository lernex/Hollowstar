{
  "name": "Metis-1.4",
  "family": "Metis",
  "description": "Metis-1.4 is a ~500M-parameter English-only MoR transformer tuned for clean conversation, short-form reasoning, math, tutoring, and stronger writing quality over raw breadth.",
  "model": {
    "architecture": "metis_mor_decoder",
    "model_type": "metis_mor_transformer",
    "vocab_size": 8192,
    "block_size": 1024,
    "d_model": 1536,
    "n_layer": 19,
    "n_heads": 24,
    "n_kv_heads": 8,
    "head_dim": 64,
    "intermediate_size": 4096,
    "hidden_act": "swiglu",
    "tie_embeddings": true,
    "rms_norm": true,
    "residual_in_fp32": false,
    "fused_add_norm": false,
    "pad_vocab_size_multiple": 16,
    "initializer_range": 0.02,
    "torch_dtype": "bfloat16",
    "attention_bias": false,
    "mlp_bias": false,
    "attention_dropout": 0.0,
    "rope_theta": 10000.0,
    "attention_backend": "flash_attention_3",
    "mor_max_depth": 3,
    "mor_router_hidden_dim": 256,
    "mor_router_temperature": 1.0,
    "mor_router_aux_loss_coef": 0.01,
    "mor_target_avg_depth": 1.5,
    "fp8_pad_multiple": 16,
    "estimated_params": 491189251,
    "effective_layer_count": 57,
    "target_effective_layer_count": 28.5
  },
  "tokenizer": {
    "vocab_size": 8192,
    "sample_docs": 12000000,
    "min_frequency": 2,
    "progress_interval": 5000
  },
  "data_manifests": {
    "pretrain_best_research": "configs/metis14_pretrain_mix_best_research.json",
    "pretrain_release_clean": "configs/metis14_pretrain_mix_release_clean.json",
    "continued_pretrain": "configs/metis14_continued_pretrain_mix.json",
    "chat_sft": "configs/metis14_chat_mix.json",
    "reasoning_sft": "configs/metis14_reasoning_mix.json",
    "preference": "configs/metis14_preference_mix.json"
  },
  "selected_data_strategy": {
    "pretrain": "best_research",
    "continued_pretrain": true,
    "chat": "metistalk_v1",
    "think": "short_visible_reasoning_v1",
    "preference": "reward_model_then_dpo_v1"
  },
  "hardware": {
    "target_cluster": "aws_p5.4xlarge",
    "accelerator": "1x NVIDIA H100 80GB",
    "world_size": 1,
    "preferred_precision": "fp8_hybrid",
    "fallback_precision": "bf16",
    "attention_backend": "flash_attention_3",
    "flash_attention_source": "Dao-AILab/flash-attention hopper package",
    "flash_attention_cuda_min": "12.3",
    "flash_attention_cuda_recommended": "12.8",
    "fp8": {
      "enabled": true,
      "format": "HYBRID",
      "margin": 0,
      "amax_history_len": 16,
      "amax_compute_algo": "max"
    },
    "launcher": {
      "torchrun_nproc_per_node": 1,
      "omp_num_threads": 8,
      "nccl_debug": "WARN"
    }
  },
  "pretrain": {
    "target_train_tokens": 1048576,
    "gates": [
      {
        "label": "gate_50pct",
        "tokens": 524288
      },
      {
        "label": "gate_75pct",
        "tokens": 786432
      },
      {
        "label": "gate_100pct",
        "tokens": 1048576
      }
    ],
    "val_ratio": 0.01,
    "base_lr": 0.00014,
    "warmup_ratio": 0.02,
    "weight_decay": 0.1,
    "optimizer_beta1": 0.9,
    "optimizer_beta2": 0.95,
    "local_batch_size": 64,
    "grad_accum_steps": 2,
    "log_interval": 1,
    "eval_interval": 2,
    "checkpoint_interval": 2
  },
  "continued_pretrain": {
    "target_train_tokens": 524288,
    "val_ratio": 0.01,
    "base_lr": 7e-05,
    "warmup_ratio": 0.03,
    "weight_decay": 0.1,
    "optimizer_beta1": 0.9,
    "optimizer_beta2": 0.95,
    "local_batch_size": 64,
    "grad_accum_steps": 2,
    "checkpoint_interval": 2
  },
  "chat_sft": {
    "max_length": 1024,
    "target_examples": 128,
    "epochs": 1.4,
    "base_lr": 5e-05,
    "warmup_ratio": 0.03,
    "local_batch_size": 32,
    "grad_accum_steps": 2,
    "checkpoint_interval": 2
  },
  "reasoning_sft": {
    "max_length": 1024,
    "target_examples": 64,
    "epochs": 1.0,
    "base_lr": 3.5e-05,
    "warmup_ratio": 0.04,
    "local_batch_size": 16,
    "grad_accum_steps": 2,
    "checkpoint_interval": 2,
    "recommended_max_think_chars": 320,
    "recommended_max_answer_chars": 320
  },
  "preference_optimization": {
    "target_pairs": 64,
    "reward_model_examples": 64,
    "epochs": 1.0,
    "base_lr": 1.5e-05,
    "warmup_ratio": 0.05,
    "local_batch_size": 8,
    "grad_accum_steps": 4,
    "checkpoint_interval": 2,
    "method": "RM_then_DPO",
    "beta": 0.1
  },
  "release": {
    "namespace": "Lernex",
    "repos": {
      "base": "Lernex/Metis-1.4-base",
      "chat": "Lernex/Metis-1.4-chat",
      "think": "Lernex/Metis-1.4-think"
    }
  },
  "runtime_notes": {
    "smoke_run": {
      "purpose": "Validate the full 1xH100 Metis-1.4 FP8 pipeline end to end before the paid run.",
      "pretrain_steps": 8,
      "continued_pretrain_steps": 4,
      "chat_examples": 128,
      "reasoning_examples": 64,
      "reward_examples": 64,
      "dpo_pairs": 64
    }
  }
}
