@article{mesh2025,
  title  = {MeSH: Memory-as-State-Highways for Recursive Transformers},
  journal = {arXiv preprint arXiv:2510.07739},
  year   = {2025},
  note   = {[VERIFIED] B state slots m_b in R^{L x D}, slot 0 initialized to embeddings, B = N_loop + 3. Per-iteration Write/Read routers with UNIQUE parameters per iteration t, softmax over slots conditioned on h^(t) only. Additive write, weighted-sum read. Fixed recursion count, no halting, no MoE in the main method, no route information stored, memory feeds only the representation path. Evaluated on Pythia 160M-6.9B: +1.06 pt average downstream with 33 percent fewer non-embedding parameters. Structurally closest to a multi-stream residual with pass-dependent mixing -- i.e. convergent with recursion-aware mHC, NOT prior art for MoRE-RM.}
}

