{
  "seed": 42,
  "max_history_turns": 3,
  "stage": "chat_sft",
  "profile": "metis15_1p2m_chat_sft_bucketed_v1",
  "target_examples": 1200000,
  "notes": [
    "Chat SFT is now an internal alignment stage only; Metis-1.5 releases base and think, not a separate chat checkpoint.",
