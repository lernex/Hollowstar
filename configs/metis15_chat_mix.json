      "hellaswag",
      "openbookqa",
      "sciq",
      "truthfulqa",
      "gpqa",
      "alpacaeval",
      "mt_bench",
      "ifeval",
      "arena_hard"
    ]
  },
  "caps": {
    "same_bucket_fallback_only": true,
    "max_single_source_share": 0.25,
    "openhermes_max_examples": 80000,
    "code_examples_max_share": 0.05
