{
  "name": "Metis-1.4-H100-dense-sanity",
  "family": "Metis",
  "description": "Reconstructed Metis-1.4 dense 500M-ish training-throughput sanity config for H100 stack checks.",
  "model": {
    "architecture": "metis_mor_decoder",
    "model_type": "metis_mor_transformer",
    "vocab_size": 16384,
    "block_size": 1024,
    "d_model": 1536,
    "n_layer": 19,
    "n_heads": 24,
    "n_kv_heads": 8,
    "head_dim": 64,
    "intermediate_size": 4096,
    "hidden_act": "swiglu",
    "tie_embeddings": true,
    "rms_norm": true,
    "residual_in_fp32": false,
    "fused_add_norm": false,
    "pad_vocab_size_multiple": 16,
    "initializer_range": 0.02,
    "torch_dtype": "bfloat16",
    "attention_bias": false,
    "mlp_bias": false,
    "attention_dropout": 0.0,
    "rope_theta": 10000.0,
    "attention_backend": "flash_attention_3",
    "training_mode": "static_dense_pretrain",
    "mor_enabled": false,
    "mor_train_router": false,
    "mor_runtime_mode": "disabled",
    "attention_mask_mode": "causal_none",
    "disable_depth_stack": true,
    "disable_token_packing": true,
    "disable_token_scatter": true,
    "mor_max_depth": 1,
    "mor_router_hidden_dim": 256,
    "mor_router_temperature": 1.0,
    "mor_router_aux_loss_coef": 0.0,
    "mor_target_avg_depth": 1.0,
    "low_precision_mode": "fp8",
    "fp8_pad_multiple": 16,
    "lm_loss_impl": "liger_fused_linear_ce"
  },
  "hardware": {
    "accelerator": "1x NVIDIA H100 80GB",
    "preferred_precision": "fp8_hybrid",
    "fallback_precision": "bf16",
    "attention_backend": "flash_attention_3",
    "fp8": {
      "enabled": true,
      "format": "HYBRID",
      "margin": 0,
      "amax_history_len": 16,
      "amax_compute_algo": "max"
    }
  }
}
