          "streaming": true,
          "target_pairs": 48000,
          "format": "helpsteer3_preference",
          "use_for": ["reward_model", "dpo"],
          "filters": {
            "allowed_languages": ["English", "english", "en"],
            "allowed_domains": ["General", "STEM"],
            "excluded_domains": ["Code", "Multilingual", "code", "python"],
            "drop_ties": true,
            "drop_code": true
          }
        }
      ]
    },
    {
