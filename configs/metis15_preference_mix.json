{
  "seed": 42,
  "stage": "preference_optimization",
  "profile": "metis15_400k_rm_300k_dpo_bucketed_v1",
  "target_reward_pairs": 400000,
  "target_dpo_pairs": 300000,
  "bootstrap_target_pairs": 328000,
  "on_policy_target_pairs": {
    "reward_model": 72000,
    "dpo": 54000,
    "chat_share": 0.10,
    "think_share": 0.08
  },
  "notes": [
    "The bootstrap preference mix intentionally excludes on-policy generated negatives; the AWS launcher mines those after chat and think checkpoints exist.",
    "Final target is 400K reward-model pairs and 300K DPO pairs. Bootstrap pairs provide 82%; on-policy Metis-generated negatives provide 18%.",
    "Nectar is capped at 10% final share and can never refill other buckets."
  ],
  "global_filters": {
    "language": "en",
    "english_confidence_min": 0.9,
    "drop_code": true,
    "drop_multilingual": true,
    "max_chosen_rejected_length_ratio": 2.5,
    "benchmark_decontam": [
      "mmlu",
      "mmlu_pro",
      "gsm8k",
      "math",
      "aime",
      "amc",
      "olympiadbench",
      "gpqa",
      "ifeval",
      "mt_bench",
      "rewardbench",
      "arena_hard"
    ]
  },
  "caps": {
    "same_bucket_fallback_only": true,
    "max_single_source_share": 0.25,
    "nectar_max_share": 0.10,
    "helpsteer3_share": 0.12,
    "on_policy_share": 0.18,
    "code_examples_max_share": 0.05,
    "single_teacher_family_max_share": 0.35
  },
  "buckets": [
