  "on_policy_generation": {
    "enabled": true,
    "included_in_target_pairs": true,
    "reward_model_pairs": 72000,
    "dpo_pairs": 54000,
    "reward_chat_pairs": 40000,
    "reward_think_pairs": 32000,
    "dpo_chat_pairs": 30000,
    "dpo_think_pairs": 24000,
    "seed_sources": ["chat_sft", "reasoning_sft"],
    "negative_policy": [
      "Generate rejected answers from the current chat checkpoint that are plausible but too vague, verbose, or under-specified.",
      "Generate rejected answers from the current think checkpoint that reason visibly but land on the wrong final answer or malformed format.",
      "Keep chosen answers from cleaned bootstrap pairs or verified math/science solutions.",
      "Drop generated pairs where both answers are bad, non-English, code-heavy, unsafe, or benchmark-contaminated."
