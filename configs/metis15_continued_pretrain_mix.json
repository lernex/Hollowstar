{
  "seed": 42,
  "stage": "continued_pretrain",
  "profile": "metis15_10b_bucketed_cpt_v1",
  "target_train_tokens": 10000000000,
  "notes": [
    "Metis-1.5 continued pretrain is a 10B STEM, knowledge, math, and reasoning-document midtrain.",
