      "mmlu_pro",
      "arc",
      "hellaswag",
      "openbookqa",
      "sciq",
      "truthfulqa",
      "gpqa",
      "gsm8k",
      "math",
      "aime",
      "amc",
      "olympiadbench",
      "minerva_math",
      "svamp",
      "asdiv",
      "ifeval",
      "mt_bench",
      "arena_hard",
      "rewardbench"
    ]
  },
  "caps": {
