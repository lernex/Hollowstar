  "global_filters": {
    "language": "en",
    "english_confidence_min": 0.9,
    "paragraph_english_ratio_min": 0.85,
    "script": "Latn",
    "code_ratio_max": 0.15,
    "global_exact_dedup": true,
    "global_near_dedup": true,
    "benchmark_decontam": [
