  "runtime_notes": {
    "architecture": {
      "routed_experts": 32,
      "top_k": 4,
      "shared_experts": 1,
      "moe_heads": 1,
      "latent_dim": 512,
      "expert_hidden": 1024,
      "activation": "squared_relu",
      "routing": "Each token is projected once from 1536d into one 512d latent vector. The router selects top-4 experts once per token, routed experts operate in the 512d latent space, and the combined latent output is projected back to the full token channel. The shared expert stays full-dim and BF16.",
      "expert_parallel": "The Google TPU v6e-8 JAX/libTPU lane now uses full data parallelism for Metis-1.5: every TPU chip keeps all 32 routed experts locally, runs static sort-packed routing and expert execution on its local batch shard, then synchronizes gradients once per optimizer step with lax.pmean.",
      "nemotron_megatron_alignment": "Native Metis keeps the bring-up dispatcher as static JAX sort-pack, but the promoted throughput branch disables shard_map expert parallelism. True TPU throughput promotion requires the v6e compile logs to prove the data-parallel layout improves utilization without loss collapse, excessive HBM pressure, or expert-drop regressions.",
      "balance_strategy": "Aux-loss-free bias routing with a 1e-3 non-gradient bias update for top-k selection plus a tiny 1e-4 standard balance aux loss for telemetry and gentle pressure.",
      "mor_strategy": "Base pretraining stays static dense. Continued pretraining switches to hard static-packed token MoR with a 1..3 recursion budget, a 1.05->1.65 average-depth warmup over the first 1B CPT tokens, fixed-capacity depth packing/scatter for recursive passes, and MoE balance-bias updates scaled by recursive active-token fraction.",
      "active_budget": "The H100 launch gate is the compute audit, not the old active-param estimate: rough_total_param_apps_per_token must stay at or below 450M before paid training."
    }
  }
